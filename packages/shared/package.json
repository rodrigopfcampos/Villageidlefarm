{
  "name": "@vif/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Contratos (tipos, erros, eventos, IApi, layout), catálogo e fórmulas compartilhados.",
  "exports": {
    ".": "./src/index.ts",
